# Copy to /etc/comikflix.env (mode 0600) and fill in values.
# comikflix.service loads this via EnvironmentFile=-/etc/comikflix.env
# Do NOT commit real secrets.
#
# Same Cloudflare auth as jarvis-mcp (REST API token — not S3 access keys).

# --- Cloudflare R2 (REST / bearer token) — required for ingest uploads ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Bucket name (created on first ingest if missing). Default: comikflix-media
# R2_BUCKET=comikflix-media
# Optional public/CDN base (no trailing slash). If unset, images are served via /api/r2/...
# R2_PUBLIC_BASE_URL=https://media.example.com

# --- SQLite (optional; default: <app>/data/comikflix.db) ---
# COMIKFLIX_DB=/root/workspace/ComikFlix/data/comikflix.db
